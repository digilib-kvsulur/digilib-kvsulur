{
  "name": "kvsulur-dlms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env ELECTRON=true vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.kvsulur.dlms",
    "productName": "PM SHRI KV Sulur DLMS",
    "copyright": "© 2024 PM SHRI Kendriya Vidyalaya Sulur. All rights reserved.",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "PM SHRI Kendriya Vidyalaya Sulur"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/logos/kv.ico",
      "uninstallerIcon": "public/logos/kv.ico",
      "installerHeaderIcon": "public/logos/kv.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KV Sulur DLMS"
    },
    "publish": null
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
