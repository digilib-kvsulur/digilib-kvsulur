    "jimp": "^0.16.13",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
